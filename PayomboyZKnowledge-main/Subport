-- 1. Helper: Decode Byte/Hex/Unicode Escape Sequences
function Subport.Deobfuscator.DecodeEscapes(str)
    if not str or type(str) ~= "string" then return "" end
    local res = str:gsub("\\(%d%d%d)", function(d)
        local n = tonumber(d)
        if n and n >= 32 and n <= 126 then return string.char(n)
        elseif n == 10 then return "\n"
        elseif n == 9 then return "\t"
        elseif n == 13 then return "\r"
        end
        return "\\" .. d
    end)
    res = res:gsub("\\x(%x%x)", function(h)
        local n = tonumber(h, 16)
        if n and n >= 32 and n <= 126 then return string.char(n)
        elseif n == 10 then return "\n"
        elseif n == 9 then return "\t"
        end
        return "\\x" .. h
    end)
    return res
end

-- 2. Static Pattern & Constant Pool Extractor (100% Safe, Zero-Crash)
function Subport.Deobfuscator.AnalyzeBytecodeConstants(rawSource)
    local urls, remotes, services, allConstants = {}, {}, {}, {}
    local seen = {}

    local function recordStr(s)
        if not s or type(s) ~= "string" then return end
        s = s:gsub("^%s*(.-)%s*$", "%1")
        if #s < 2 or #s > 2500 or seen[s] then return end
        seen[s] = true
        table.insert(allConstants, s)

        local sLower = s:lower()
        if s:find("^https?://") or sLower:find("discord%.com/api/webhooks") or sLower:find("raw%.githubusercontent%.com") or sLower:find("pastebin%.com") then
            table.insert(urls, s)
        elseif sLower:find("remote") or sLower:find("event") or sLower:find("function") or sLower:find("attack") or sLower:find("combat") or sLower:find("kill") or sLower:find("damage") or sLower:find("reward") then
            table.insert(remotes, s)
        elseif s == "Workspace" or s == "Players" or s == "ReplicatedStorage" or s == "HttpService" or s == "TweenService" or s == "RunService" or s == "UserInputService" or s == "CoreGui" then
            table.insert(services, s)
        end
    end

    -- Extract Escaped Strings
    local decodedSource = Subport.Deobfuscator.DecodeEscapes(rawSource)

    -- Extract String Literals
    for s in string.gmatch(decodedSource, '"([^"\\]+)"') do recordStr(s) end
    for s in string.gmatch(decodedSource, "'([^'\\]+)'") do recordStr(s) end

    -- Extract string.char(...) patterns
    decodedSource:gsub("string%.char%s*%(%s*([%d%s,]+)%s*%)", function(args)
        local chars = {}
        for d in string.gmatch(args, "%d+") do
            local byteVal = tonumber(d)
            if byteVal and byteVal >= 32 and byteVal <= 126 then
                table.insert(chars, string.char(byteVal))
            end
        end
        if #chars > 2 then recordStr(table.concat(chars)) end
    end)

    return {
        Urls = urls,
        Remotes = remotes,
        Services = services,
        Constants = allConstants,
        Count = #allConstants,
        DecodedSource = decodedSource
    }
end

-- 3. Isolated Sandboxed Dynamic Tracer (Anti-Hang, Step Quota, Zero Global Tampering)
function Subport.Deobfuscator.SafeDynamicTrace(rawCode, options)
