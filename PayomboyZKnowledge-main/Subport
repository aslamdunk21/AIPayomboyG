function Subport.Network.GenerateLuauRequest(packet)
    if not packet or not packet.Url then return "-- Invalid packet data" end
    local method = packet.Method or "GET"
    local url = packet.Url
    local body = packet.Body or ""

    if method == "GET" and (not packet.Headers or next(packet.Headers) == nil) and body == "" then
        return string.format('local response = game:HttpGet(%q)\nprint(response)', url)
    end

    local hJson = (packet.Headers and next(packet.Headers)) and HttpService:JSONEncode(packet.Headers) or "{}"
    return string.format([[local req = (typeof(request) == "function" and request) or (typeof(http_request) == "function" and http_request) or (syn and syn.request)
