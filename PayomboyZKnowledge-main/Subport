Subport.Deobfuscator = {}

function Subport.Deobfuscator.AnalyzeBytecodeConstants(rawSource)
    local urls, remotes, services, allConstants = {}, {}, {}, {}
    local seen = {}

    local function recordStr(s)
        if not s or type(s) ~= "string" then return end
        s = s:gsub("^%s*(.-)%s*$", "%1")
        if #s < 2 or #s > 2000 or seen[s] then return end
        seen[s] = true
        table.insert(allConstants, s)

        local sLower = s:lower()
        if s:find("^https?://") or sLower:find("discord%.com/api/webhooks") or sLower:find("raw%.githubusercontent%.com") or sLower:find("pastebin%.com") then
            table.insert(urls, s)
        elseif sLower:find("remote") or sLower:find("event") or sLower:find("function") or sLower:find("attack") or sLower:find("combat") or sLower:find("kill") or sLower:find("damage") or sLower:find("reward") then
            table.insert(remotes, s)
        elseif s == "Workspace" or s == "Players" or s == "ReplicatedStorage" or s == "HttpService" or s == "TweenService" or s == "RunService" then
            table.insert(services, s)
        end
    end

    -- 1. Extract string literals
    for s in string.gmatch(rawSource, '"([^"\\]+)"') do recordStr(s) end
    for s in string.gmatch(rawSource, "'([^'\\]+)'") do recordStr(s) end

    -- 2. Extract string.char(...) patterns
    rawSource:gsub("string%.char%s*%(%s*([%d%s,]+)%s*%)", function(args)
        local chars = {}
        for d in string.gmatch(args, "%d+") do
            local byteVal = tonumber(d)
            if byteVal and byteVal >= 32 and byteVal <= 126 then
                table.insert(chars, string.char(byteVal))
            end
        end
        if #chars > 2 then recordStr(table.concat(chars)) end
    end)

    return {
        Urls = urls,
        Remotes = remotes,
        Services = services,
        Constants = allConstants,
        Count = #allConstants
    }
end

function Subport.Deobfuscator.FormatReconstructedCode(analysisData, title)
    local lines = {}
    local function add(l) table.insert(lines, l or "") end

    add("-- ======================================================================================")
    add(string.format("-- [[ 🔓 PAYOMBOYZ DEOBFUSCATOR V8.5: %s ]]", string.upper(title or "RECONSTRUCTED LUAU SOURCE")))
    add("-- Source Processed by PayomboyZ Subport High-Capacity Extension Engine")
    add(string.format("-- Telemetry: %d Decrypted Constants | %d Network Endpoints | %d Identified Remotes", #analysisData.Constants, #analysisData.Urls, #analysisData.Remotes))
    add("-- ======================================================================================\n")

    if #analysisData.Urls > 0 then
        add("-- [[ 🌐 EXTRACTED URLS & WEBHOOKS ]]")
        for i, u in ipairs(analysisData.Urls) do
            add(string.format("local URL_%d = %q", i, u))
        end
        add("")
    end

    if #analysisData.Services > 0 or #analysisData.Remotes > 0 then
        add("-- [[ 📡 TARGETED SERVICES & REMOTES ]]")
        for _, s in ipairs(analysisData.Services) do
            add(string.format("local %s = game:GetService(%q)", s, s))
        end
        for i, r in ipairs(analysisData.Remotes) do
            add(string.format("local Remote_%d = %q", i, r))
        end
        add("")
    end

    add("-- [[ 📦 DECRYPTED CONSTANT POOL (FIRST 120) ]]")
    add("local Constants = {")
    for i = 1, math.min(120, #analysisData.Constants) do
        add(string.format("    [%d] = %q,", i, analysisData.Constants[i]))
    end
    add("}\n")

    return table.concat(lines, "\n")
end

