            end
            add("")
        end

        if #dynChunks > 0 then
            add("-- [[ 🚀 EXTRACTED INNER DYNAMIC CHUNKS (FROM LOADSTRING) ]]")
            for i, chunk in ipairs(dynChunks) do
                add(string.format("-- --- PAYLOAD CHUNK [%d] (%d bytes) ---", i, #chunk))
                add(chunk)
