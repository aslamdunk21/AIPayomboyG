        if callback then
            callback({
                Success = true,
                CleanSource = cleanSource,
                DumpLog = dumpOutput,
                Urls = urls,
                Remotes = remotes,
                Services = services,
                Constants = constants,
                Chunks = dynChunks,
                Elapsed = totalElapsed
            })
        end
    end)
end

