    local maxLogs = options.MaxLogs or 1500
    local dumpLogs = {}
    local capturedStrings = {}
    local capturedChunks = {}
    local seenStrs = {}
    local stepCounter = 0

    local function dump(msg)
        if #dumpLogs < maxLogs then
            table.insert(dumpLogs, tostring(msg or ""))
        end
    end

    local function recordString(s)
        if typeof(s) == "string" and #s >= 2 and not seenStrs[s] then
            seenStrs[s] = true
            table.insert(capturedStrings, s)
        end
    end

    -- Isolated environment (DO NOT taint global string/table)
    local sandboxString = {}
    for k, v in pairs(string) do sandboxString[k] = v end

    local orig_sub = string.sub
    local orig_char = string.char
    local orig_byte = string.byte
    local orig_gsub = string.gsub
    local orig_concat = table.concat

    sandboxString.sub = function(s, i, j)
        stepCounter = stepCounter + 1
        if stepCounter > maxSteps then error("[Anti-Hang Watchdog] Sandbox execution step budget reached") end
        local r = orig_sub(s, i, j)
        if typeof(s) == "string" and #s > 18 and #r > 1 then
            dump("[STR] sub: " .. tostring(r))
            recordString(r)
        end
        return r
    end

    sandboxString.char = function(...)
        stepCounter = stepCounter + 1
        if stepCounter > maxSteps then error("[Anti-Hang Watchdog] Sandbox execution step budget reached") end
        local r = orig_char(...)
        if #r > 0 then
            dump("[STR] char: " .. tostring(r))
            recordString(r)
        end
        return r
    end

    sandboxString.byte = function(s, i, j)
        stepCounter = stepCounter + 1
        if stepCounter > maxSteps then error("[Anti-Hang Watchdog] Sandbox execution step budget reached") end
        local r = orig_byte(s, i, j)
        if typeof(s) == "string" and #s > 20 then
            dump("[BYTE] from: " .. orig_sub(s, 1, 30) .. " = " .. tostring(r))
        end
        return r
    end

    sandboxString.gsub = function(s, p, r, n)
        stepCounter = stepCounter + 1
        if stepCounter > maxSteps then error("[Anti-Hang Watchdog] Sandbox execution step budget reached") end
        local res = orig_gsub(s, p, r, n)
        if typeof(s) == "string" and #s > 15 then
            dump("[GSUB] " .. orig_sub(s, 1, 35) .. " -> " .. orig_sub(res, 1, 35))
            recordString(res)
        end
        return res
    end

    local sandboxTable = {}
    for k, v in pairs(table) do sandboxTable[k] = v end
    sandboxTable.concat = function(t, sep, i, j)
        stepCounter = stepCounter + 1
        if stepCounter > maxSteps then error("[Anti-Hang Watchdog] Sandbox execution step budget reached") end
        local r = orig_concat(t, sep, i, j)
        if typeof(r) == "string" and #r > 4 then
            dump("[CONCAT] " .. tostring(r))
            recordString(r)
        end
        return r
    end

    local sandboxEnv = {}
    for k, v in pairs(_G) do sandboxEnv[k] = v end
    if typeof(getgenv) == "function" then
        pcall(function() for k, v in pairs(getgenv()) do sandboxEnv[k] = v end end)
    end

    sandboxEnv.string = sandboxString
    sandboxEnv.table = sandboxTable
    sandboxEnv.load = function(chunk, name, mode, env)
        if typeof(chunk) == "string" and #chunk > 30 then
            dump(string.format("\n[LOADSTRING INTERCEPTED] Dynamic Payload (%d bytes):", #chunk))
            dump(orig_sub(chunk, 1, 300) .. (#chunk > 300 and "\n... [TRUNCATED]" or ""))
            table.insert(capturedChunks, chunk)
        end
        return function() end
    end
    sandboxEnv.loadstring = sandboxEnv.load

    sandboxEnv.pcall = function(f, ...)
        stepCounter = stepCounter + 1
        if stepCounter > maxSteps then error("[Anti-Hang Watchdog] Sandbox execution step budget reached") end
        local ok, res = pcall(f, ...)
        if not ok then dump("[SANDBOX TRAP] " .. tostring(res)) end
        return ok, res
    end

    dump("=== [PayomboyZ Safe VM Sandbox Initialized] ===")
    dump("Target Size: " .. string.format("%.2f KB", #rawCode / 1024))
    dump("Watchdog Quota: " .. maxSteps .. " steps (Anti-Hang Active)")

    local compFunc = loadstring or load
    if compFunc then
        local fn, err = compFunc(rawCode)
        if not fn then fn, err = compFunc("return (" .. rawCode .. ")") end

        if fn and typeof(fn) == "function" then
            if typeof(setfenv) == "function" then
                pcall(function() setfenv(fn, sandboxEnv) end)
            end
            local ok, result = pcall(fn)
            if ok then
