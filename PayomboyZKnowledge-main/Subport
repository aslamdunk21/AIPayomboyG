-- Dex-grade Value Serializer (แปลง CFrame, Vector3, Color3, Enum, Tables)
function Subport.DexBridge.FormatValue(val, depth)
    depth = depth or 0
    if depth > 4 then return tostring(val) end
    local t = typeof(val)
    if t == "string" then
        return string.format("%q", val)
    elseif t == "number" or t == "boolean" then
        return tostring(val)
    elseif t == "nil" then
        return "nil"
    elseif t == "Vector3" then
        return string.format("Vector3.new(%.3f, %.3f, %.3f)", val.X, val.Y, val.Z)
    elseif t == "Vector2" then
        return string.format("Vector2.new(%.3f, %.3f)", val.X, val.Y)
    elseif t == "CFrame" then
        local p = val.Position
        return string.format("CFrame.new(%.3f, %.3f, %.3f)", p.X, p.Y, p.Z)
    elseif t == "Color3" then
        return string.format("Color3.fromRGB(%d, %d, %d)", math.floor(val.R * 255), math.floor(val.G * 255), math.floor(val.B * 255))
    elseif t == "EnumItem" then
        return tostring(val)
    elseif t == "Instance" then
        return string.format("game:GetService(%q)%s", val:GetFullName():match("^([^.]+)"), val:GetFullName():match("^[^.]+(.*)") or "")
    elseif t == "table" then
        local parts = {}
        local isArray = (#val > 0)
        for k, v in pairs(val) do
            local kStr = isArray and "" or string.format("[%s] = ", Subport.DexBridge.FormatValue(k, depth + 1))
            table.insert(parts, kStr .. Subport.DexBridge.FormatValue(v, depth + 1))
            if #parts > 20 then
                table.insert(parts, "... [truncated]")
                break
            end
        end
        return "{" .. table.concat(parts, ", ") .. "}"
    end
    return string.format("%q", tostring(val))
end

-- Dex-style Closure Constants & Upvalues Inspection
function Subport.DexBridge.InspectClosure(fn)
    if typeof(fn) ~= "function" then return {} end
    local info = {
        Constants = {},
        Upvalues = {},
        ProtosCount = 0
    }
    local getconsts = debug and debug.getconstants or getconstants
    if typeof(getconsts) == "function" then
        pcall(function()
            for _, c in ipairs(getconsts(fn)) do
                table.insert(info.Constants, c)
            end
        end)
    end
    local getups = debug and debug.getupvalues or getupvalues
    if typeof(getups) == "function" then
        pcall(function()
            for k, v in pairs(getups(fn)) do
                info.Upvalues[k] = v
            end
        end)
    end
    local getpr = debug and debug.getprotos or getprotos
    if typeof(getpr) == "function" then
        pcall(function()
            local pr = getpr(fn)
            info.ProtosCount = (type(pr) == "table" and #pr) or 0
        end)
    end
    return info
end

