function Subport.AntiCheat.AnalyzeScriptFlags(scriptInstance)
    local flags = {}
    local src = ""
    if typeof(getscriptbytecode) == "function" then
        pcall(function() src = getscriptbytecode(scriptInstance) or "" end)
    end
