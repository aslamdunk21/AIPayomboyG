Subport.Dumper = {}

function Subport.Dumper.SerializeValue(val)
    local t = typeof(val)
    if t == "string" then return string.format("%q", val) end
    if t == "number" or t == "boolean" then return tostring(val) end
    if t == "nil" then return "nil" end
    if t == "Vector3" then return string.format("Vector3.new(%.2f, %.2f, %.2f)", val.X, val.Y, val.Z) end
    if t == "Vector2" then return string.format("Vector2.new(%.2f, %.2f)", val.X, val.Y) end
    if t == "CFrame" then
        local p = val.Position
        return string.format("CFrame.new(%.2f, %.2f, %.2f)", p.X, p.Y, p.Z)
    end
    if t == "Color3" then return string.format("Color3.fromRGB(%d, %d, %d)", math.floor(val.R * 255), math.floor(val.G * 255), math.floor(val.B * 255)) end
    if t == "Instance" then return string.format("game.%s", val:GetFullName()) end
    return string.format("%q", tostring(val))
end

function Subport.Dumper.DumpInstanceTree(root, maxDepth)
    maxDepth = maxDepth or 4
    local lines = {}
    local function recurse(obj, depth)
        if depth > maxDepth then return end
        local indent = string.rep("  ", depth)
        lines[#lines + 1] = string.format("%s[%s] %s", indent, obj.ClassName, obj.Name)
        
        -- Serialize Attributes
        local okAttr, attrs = pcall(function() return obj:GetAttributes() end)
        if okAttr and attrs then
            for k, v in pairs(attrs) do
                lines[#lines + 1] = string.format("%s  @%s = %s", indent, k, Subport.Dumper.SerializeValue(v))
            end
        end

        for _, child in ipairs(obj:GetChildren()) do
            recurse(child, depth + 1)
        end
    end
    recurse(root, 0)
    return table.concat(lines, "\n")
end

