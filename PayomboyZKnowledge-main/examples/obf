            ObsidianGlassEngine:Notify({ Title = "Input Required", Content = "Please paste obfuscated code first", Duration = 3 })
            return
        end

        ObsidianGlassEngine:Notify({ Title = "Analyzing VM", Content = "Devirtualizing opcodes & extracting constants...", Duration = 3 })
        local sig = detectObfuscatorSignature(raw)
        local deobfResult = synthesizeFullDeobfuscation(raw)
        safeSetText(deobfCodeBox, deobfResult)
        deobfMetaLabel.Text = string.format("DEOBFUSCATED: %s | Original Size: %.2f KB | Reconstructed Lines: %d", sig, #raw / 1024, select(2, deobfResult:gsub("\n", "\n")) + 1)
        ObsidianGlassEngine:Notify({ Title = "Deobfuscation Complete", Content = "VM devirtualized and constants extracted!", Duration = 4 })
    end)

    renderChunksList()
end

