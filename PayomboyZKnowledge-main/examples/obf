function AICentralBrain:DetectGameGenre()
    local name = (self.Environment.PlaceName or ""):lower()
    -- 1. Check RPG / Combat first (Mobs, Swords, Anime, Dungeons, Piece, Blox, Slayer, Bandit)
    if #self.Environment.Mobs > 0 or name:find("fruit") or name:find("blox") or name:find("piece") or name:find("slayer") or name:find("rpg") or name:find("dungeon") or name:find("bandit") or name:find("sword") or name:find("blade") or name:find("sea") then
        return "RPG_COMBAT"
    end
    -- 2. Shooter / FPS
    if name:find("arsenal") or name:find("counter") or name:find("fps") or name:find("shoot") or name:find("gun") or name:find("paintball") or name:find("rival") or name:find("battleground") then
        return "SHOOTER_FPS"
    end
    -- 3. Obby / Tower / Parkour
    if name:find("obby") or name:find("tower") or name:find("parkour") or name:find("jump") then
        return "OBBY"
    end
    -- 4. Simulator / Tycoon / Idle Collector
    if name:find("simulator") or name:find("tycoon") or name:find("pet") or name:find("egg") or name:find("click") or name:find("mine") or name:find("fish") or #self.Environment.InteractiveFolders > 0 or #self.Environment.Prompts > 0 then
        return "SIMULATOR"
    end
    return "GENERIC"
end

