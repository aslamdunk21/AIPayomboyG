function AICentralBrain:FindMatchingRemote(category, tokenSet)
    tokenSet = tokenSet or {}
    local kwMap = {
        EGG_HATCH = { "egg", "hatch", "buyegg", "openegg", "purchaseegg", "pet", "buy" },
        REBIRTH = { "rebirth", "prestige", "rankup", "ascend", "restart" },
        CLAIM_REWARDS = { "claim", "reward", "gift", "daily", "chest", "quest", "spin", "wheel", "collect" },
        COMBAT = { "attack", "punch", "swing", "hit", "damage", "slash", "combat", "strike", "shoot", "fire", "re/registerattack" },
        GATHER = { "mine", "fish", "cast", "reel", "chop", "harvest", "dig", "ore" },
        AUTO_CLICK = { "click", "tap", "punch", "swing", "add", "gain", "hit" },
        FARM = { "farm", "collect", "drop", "pickup" }
    }

    local targetKeywords = {}
    if kwMap[category] then
        for _, k in ipairs(kwMap[category]) do table.insert(targetKeywords, k) end
    end
    for t in pairs(tokenSet) do
        table.insert(targetKeywords, t)
    end

    -- 1. Check in SpyCalls first (has real recorded arguments!)
    if typeof(SpyCalls) == "table" and #SpyCalls > 0 then
        for _, entry in ipairs(SpyCalls) do
            local eName = (entry.Name or ""):lower()
            for _, kw in ipairs(targetKeywords) do
                if eName:find(kw, 1, true) then
                    return {
                        Remote = entry.Remote,
                        Name = entry.Name,
                        Class = entry.Class or "RemoteEvent",
                        Path = entry.Path or (entry.Remote and entry.Remote:GetFullName()) or "game:GetService('ReplicatedStorage')",
                        Args = entry.Args or {},
                        Source = "SPY_CAPTURED"
                    }
                end
            end
        end
    end

    -- 2. Check scanned environment remotes
    if self.Environment and self.Environment.Remotes and self.Environment.Remotes.All then
        for _, r in ipairs(self.Environment.Remotes.All) do
            local rName = (r.Name or ""):lower()
            for _, kw in ipairs(targetKeywords) do
                if rName:find(kw, 1, true) then
                    local fullPath = r:GetFullName()
                    return {
                        Remote = r,
                        Name = r.Name,
                        Class = r.ClassName,
                        Path = fullPath,
                        Args = {},
                        Source = "ENVIRONMENT_SCAN"
                    }
                end
            end
        end
    end

    return nil
end

function AICentralBrain:RegisterACDetection(findings)
    self.Environment.AntiCheatProfile.Suspects = findings or {}
    self.Environment.AntiCheatProfile.DetectedCount = #(findings or {})
    if #self.Environment.AntiCheatProfile.Suspects > 0 then
        self.Environment.AntiCheatProfile.BypassesRequired = {
            SafeVelocity = true,
            SafeNoclip = true,
            SafeLerp = true,
            RemoteThrottle = true
        }
        DebugLog("WARN", "CENTRAL_BRAIN", string.format("Security Alert: Ingested %d Anti-Cheat signatures. Auto-defense bypasses armed.", #findings))
    else
        self.Environment.AntiCheatProfile.BypassesRequired = {}
        DebugLog("INFO", "CENTRAL_BRAIN", "Anti-Cheat scan clean. Standard execution mode enabled.")
    end
end

