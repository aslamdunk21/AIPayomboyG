    local function installDynamicHook()
        if originalLoadstring then return end
        local targetEnv = (typeof(getgenv) == "function") and getgenv() or _G

        local realLoadstring = targetEnv.loadstring or loadstring
        local realLoad = targetEnv.load or load
        local isUnpacking = false

        local hookHandler = function(code, chunkName)
            if typeof(code) == "string" and unpackerActive and not isUnpacking then
                if code:find("ObsidianGlass2_UI") or code:find("PAYOMBOYZ AI GENERATE") then
                    if originalLoadstring then return originalLoadstring(code, chunkName) end
                    return function() end
                end

                isUnpacking = true
                local caller = "Unknown"
                pcall(function()
                    if typeof(getcallingscript) == "function" then
                        local cs = getcallingscript()
                        if cs then caller = cs:GetFullName() end
                    end
                end)

                local sig = detectObfuscatorSignature(code)
                local sizeKB = string.format("%.2f KB", #code / 1024)
                local deobfResult = synthesizeFullDeobfuscation(code)
                local timeStr = os.date("%H:%M:%S")
                local isBlocked = interceptBlock

                local chunkData = {
                    Raw = code,
                    Deobfuscated = deobfResult,
                    Signature = sig,
                    Caller = caller,
                    ChunkName = tostring(chunkName or "unnamed"),
                    SizeStr = sizeKB,
                    Time = timeStr,
                    Blocked = isBlocked,
                    StmtCount = select(2, deobfResult:gsub("\n", "\n")) + 1,
                    Hash = string.format("%08X", #code * 31 + string.byte(code, 1 or 1))
                }

                table.insert(capturedChunks, 1, chunkData)
                if #capturedChunks > 60 then table.remove(capturedChunks) end

                DebugLog("INFO", "UNPACKER", string.format("Dynamically devirtualized %s (%s) from %s", sig, sizeKB, caller))

                task.defer(function()
                    renderChunksList()
                    if deobfCodeBox and selectedChunkIdx == 1 then
                        safeSetText(deobfCodeBox, deobfResult)
                    end
                    if deobfMetaLabel then
                        deobfMetaLabel.Text = string.format("DEOBFUSCATED [%s]: %s (%s) from %s", timeStr, sig, sizeKB, caller)
                    end
                end)

                if isBlocked then
                    isUnpacking = false
                    DebugLog("WARN", "UNPACKER", "Execution blocked by Isolation Policy")
                    return function()
                        return nil, "[PayomboyZ Unpacker] Execution Blocked & Source Reconstructed"
                    end
                end
                isUnpacking = false
            end

            if originalLoadstring then
                return originalLoadstring(code, chunkName)
            end
            return function() end
        end

        -- Safe hook installation with trampoline support
        if typeof(hookfunction) == "function" and realLoadstring then
            local ok, tramp = pcall(function()
                return hookfunction(realLoadstring, hookHandler)
            end)
            if ok and tramp then
                originalLoadstring = tramp
            else
                originalLoadstring = realLoadstring
                targetEnv.loadstring = hookHandler
            end
        else
            originalLoadstring = realLoadstring
            targetEnv.loadstring = hookHandler
        end

        if realLoad then
            if typeof(hookfunction) == "function" then
                local ok, tramp = pcall(function()
                    return hookfunction(realLoad, hookHandler)
                end)
                if ok and tramp then
                    originalLoad = tramp
                else
                    originalLoad = realLoad
                    targetEnv.load = hookHandler
                end
            else
                originalLoad = realLoad
                targetEnv.load = hookHandler
            end
        end

        DebugLog("INFO", "UNPACKER", "Dynamic Hooking Unpacker Engine safely armed")
    end

