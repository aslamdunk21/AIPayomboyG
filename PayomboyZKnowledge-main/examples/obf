    local function prettyJSON(s)
        s = tostring(s or "")
        if #s > 4000 then s = s:sub(1, 4000) .. "\n…(truncated)" end
        local out, indent = {}, 0
        for i = 1, #s do
            local ch = s:sub(i, i)
            if ch == "{" or ch == "[" then
                indent = indent + 1
                out[#out+1] = ch .. "\n" .. string.rep("  ", indent)
            elseif ch == "}" or ch == "]" then
                indent = math.max(0, indent - 1)
                out[#out+1] = "\n" .. string.rep("  ", indent) .. ch
            elseif ch == "," then
                out[#out+1] = ch .. "\n" .. string.rep("  ", indent)
            else
                out[#out+1] = ch
            end
        end
        return table.concat(out)
    end

    local function decodeEscapedStrings(str)
        if not str or typeof(str) ~= "string" then return "" end
        local decoded = str:gsub("\\(%d%d%d)", function(d)
            local n = tonumber(d)
            if n and n >= 32 and n <= 126 then return string.char(n) end
            return "\\" .. d
        end)
        decoded = decoded:gsub("\\x(%x%x)", function(h)
            local n = tonumber(h, 16)
            if n and n >= 32 and n <= 126 then return string.char(n) end
            return "\\x" .. h
        end)
        return decoded
    end

    local function extractHttpUrls(content)
        local urls = {}
        local seen = {}
        local pattern = "https?://[^%s\"\'%)%]]+"
        for url in content:gmatch(pattern) do
            if not seen[url] then
                seen[url] = true
                table.insert(urls, url)
            end
        end
        local deobfuscated = decodeEscapedStrings(content)
        for url in deobfuscated:gmatch(pattern) do
            if not seen[url] then
                seen[url] = true
                table.insert(urls, url)
            end
        end
        return urls
    end

