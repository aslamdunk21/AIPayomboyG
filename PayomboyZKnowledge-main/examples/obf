    local name = (self.Environment.PlaceName or ""):lower()
    local allRemoteNames = ""
    if self.Environment.Remotes and self.Environment.Remotes.All then
        for _, r in ipairs(self.Environment.Remotes.All) do
            allRemoteNames = allRemoteNames .. " " .. r.Name:lower()
        end
    end
