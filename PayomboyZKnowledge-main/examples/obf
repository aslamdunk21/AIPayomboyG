                    table.insert(self.Environment.Remotes.Farm, entry)
                elseif n:find("buy") or n:find("sell") or n:find("upgrade") or n:find("shop") or n:find("purchase") or n:find("trade") or n:find("coin") or n:find("gem") or n:find("cash") or n:find("token") then
                    table.insert(self.Environment.Remotes.Economy, entry)
                elseif n:find("teleport") or n:find("warp") or n:find("zone") or n:find("door") or n:find("portal") or n:find("arena") or n:find("tower") then
                    table.insert(self.Environment.Remotes.Teleport, entry)
                end
            end
        end
    end)

    -- 2. Scan Workspace Prompts & Interactive Folders
    pcall(function()
        local ws = game:GetService("Workspace")
        for _, child in ipairs(ws:GetChildren()) do
            local cn = child.Name:lower()
            if child:IsA("Folder") or child:IsA("Model") then
                if cn:find("coin") or cn:find("egg") or cn:find("drop") or cn:find("gem") or cn:find("chest") or cn:find("ore") or cn:find("box") or cn:find("nest") or cn:find("scrap") or cn:find("pickup") or cn:find("coop") or cn:find("incubator") or cn:find("chicken") then
                    table.insert(self.Environment.InteractiveFolders, { Name = child.Name, Path = child:GetFullName(), Instance = child })
                end
            end
        end
        
        local pCount = 0
        for _, obj in ipairs(ws:GetDescendants()) do
            if obj:IsA("ProximityPrompt") then
                pCount = pCount + 1
                if pCount <= 35 then
                    table.insert(self.Environment.Prompts, {
                        Name = obj.Name,
                        ParentName = obj.Parent and obj.Parent.Name or "Unknown",
                        Path = obj:GetFullName(),
                        ActionText = obj.ActionText,
                        ObjectText = obj.ObjectText,
                        Instance = obj
                    })
                end
            end
        end
    end)

    -- 3. Scan Backpack Tools
    pcall(function()
        local lp = Players.LocalPlayer
